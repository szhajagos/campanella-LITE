# Composer
/vendor/
/app/vendor/

# Runtime data
/var/

# The website description and the admin users of an installation
# (not part of the CMS code)
/project/
/config/

# Generated pages in the web root; only the front controller, the admin
# entry point, the Apache configuration and the assets belong to the repository
/public/*
!/public/index.php
!/public/.htaccess
!/public/admin/
!/public/assets/

# Files the Claude desktop app saves when it sends files (not part of the project)
/Claude outputs/

# Tools
/.phpunit.cache/
/.php-cs-fixer.cache

# Editors and operating systems
/.idea/
/.vscode/
.DS_Store
Thumbs.db
desktop.ini
