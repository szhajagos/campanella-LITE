{
    "name": "szhajagos/campanella-lite",
    "description": "A lightweight, file-based, command-driven CMS that publishes static websites.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "cms",
        "static-site",
        "flat-file",
        "command-line",
        "bootstrap",
        "twig"
    ],
    "homepage": "https://github.com/szhajagos/campanella-LITE",
    "authors": [
        {
            "name": "Szilárd Hajagos",
            "homepage": "https://github.com/szhajagos"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Campanella\\Lite\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Campanella\\Lite\\Tests\\": "tests/"
        }
    },
    "config": {
        "vendor-dir": "app/vendor",
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "bin": [
        "bin/campanella"
    ]
}
